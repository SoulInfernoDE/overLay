# In-game overlay.

overlay-toast-active = { -app-name } is running over { $game }. { $hotkey } shows or hides the overlay.
overlay-toast-shown = Overlay shown. { $hotkey } hides it again.
overlay-demo-title = Demo widget
overlay-demo-body = Mod widgets will appear here. Drag this panel by its title bar; its position is saved for this game and resolution.
overlay-demo-window = Game window: { $width } × { $height }
overlay-demo-collapse = Collapse
overlay-demo-expand = Expand
