# In-game overlay.

overlay-toast-active = { -app-name } läuft über { $game }. { $hotkey } blendet das Overlay ein oder aus.
overlay-toast-shown = Overlay eingeblendet. { $hotkey } blendet es wieder aus.
overlay-demo-title = Demo-Widget
overlay-demo-body = Hier erscheinen die Widgets von Mods. Zieh dieses Feld an seiner Titelleiste; die Position wird für dieses Spiel und diese Auflösung gespeichert.
overlay-demo-window = Spielfenster: { NUMBER($width, useGrouping: "false") } × { NUMBER($height, useGrouping: "false") }
overlay-demo-collapse = Einklappen
overlay-demo-expand = Ausklappen
